U0 UDPSockTest()
{
  "Before any sockets added:\n";
  UDPRep;
  CUDPSock            *u0 = UDPSock(AF_INET);
  CUDPSock            *u1 = UDPSock(AF_INET);
  CUDPSock            *u2 = UDPSock(AF_INET);
  CUDPSock            *u3 = UDPSock(AF_INET);
  CUDPSock            *u4 = UDPSock(AF_INET);
  CUDPSock            *u5 = UDPSock(AF_INET);
  CSockAddrIPV4    *i0 = CAlloc(sizeof(CSockAddrIPV4));
  CSockAddrIPV4    *i1 = CAlloc(sizeof(CSockAddrIPV4));
  CSockAddrIPV4    *i2 = CAlloc(sizeof(CSockAddrIPV4));
  CSockAddrIPV4    *i3 = CAlloc(sizeof(CSockAddrIPV4));
  CSockAddrIPV4    *i4 = CAlloc(sizeof(CSockAddrIPV4));
  CSockAddrIPV4    *i5 = CAlloc(sizeof(CSockAddrIPV4));
  i0->port          = EndianU16(30);
  i0->family            = AF_INET;
  i0->addr.addr   = 0xDEADBEEF;
  i1->port          = EndianU16(25);
  i1->family            = AF_INET;
  i1->addr.addr = 0xF00DBABE;
  i2->port          = EndianU16(35);
  i2->family            = AF_INET;
  i2->addr.addr = 0xC0C0D0D0;
  i3->port          = EndianU16(20);
  i3->family            = AF_INET;
  i3->addr.addr = 0xF007BA11;
  i4->port          = EndianU16(28);
  i4->family            = AF_INET;
  i4->addr.addr = 0x0B0E5EED;
  i5->port          = EndianU16(37);
  i5->family            = AF_INET;
  i5->addr.addr = 0x00ABCDEF;
  UDPSockBind(u0, i0);
  UDPSockBind(u1, i1);
  UDPSockBind(u2, i2);
  UDPSockBind(u3, i3);
  UDPSockBind(u4, i4);
  UDPSockBind(u5, i5);
  "All sockets now bound. Currently bound:\n";
  UDPRep;
  "\n";
  UDPSockClose(u0);
  "After remove first socket\n";
  UDPRep;
  "\n";
  UDPSockClose(u1);
  "After remove second socket\n";
  UDPRep;
  "\n";
  UDPSockClose(u2);
  "After remove third socket\n";
  UDPRep;
  "\n";
  UDPSockClose(u3);
  "After remove fourth socket\n";
  UDPRep;
  "\n";
  UDPSockClose(u4);
  "After remove fifth socket\n";
  UDPRep;
  "\n";
  UDPSockClose(u5);
  "After remove sixth socket\n";
  UDPRep;
  "\n";
  Free(i0);
  Free(i1);
  Free(i2);
  Free(i3);
  Free(i4);
  Free(i5);
}

UDPSockTest;
